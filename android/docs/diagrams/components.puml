@startuml
title MusicFS Android 客户端（设计）
left to right direction
skinparam componentStyle rectangle

package "手机／平板／TV 应用" {
  [手机与平板\n自适应页面] as Touch
  [TV\n遥控器页面] as TV
}
package "独立 Wear OS 应用" {
  [手表页面] as Wear
}
package "共享 Android 模块（在各设备本机运行）" {
  [曲库与歌单] as Library
  [本机播放服务\n队列 / MediaSession / ExoPlayer] as Player
  [Server 连接\n登录会话 / 控制通道 / 媒体读取] as Connection
}
component "MusicFS Server" as Server
component "本机音频输出" as Output

Touch --> Library
TV --> Library
Wear --> Library
Touch --> Player : 触屏
TV --> Player : 遥控器
Wear --> Player : 表端操作
Library --> Connection : 查询
Player --> Connection : 创建、定位、恢复及读取音频
Player --> Output : 解码输出
Connection --> Server : HTTPS 查询与媒体读取\nWebSocket 控制
@enduml
