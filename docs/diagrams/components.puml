@startuml
title MusicFS - Components
top to bottom direction
skinparam componentStyle rectangle
package "MusicFS-web" {
  component "Reusable UI / Theme" as UI
  component "Browser Playback" as BP
}
package "MusicFS-client (Tauri)" {
  component "Bundled UI" as DUI
  component "Desktop Playback Adapter" as DP
  component "Lyrics Window / Server Launcher" as Native
}
package "MusicFS-server" {
  component "API / Auth / Events" as API
  component Library
  component "Metadata Enrichment" as Metadata
  component "Playlist / Snapshots" as Playlist
  component "Source Resolver" as Resolver
  component "Scheduler" as Scheduler
  component "Plugin Host" as Host
  component "Stream Gateway" as Stream
  database "SQLite (Indexes / Relations)" as DB
  folder "Media Store (Files)" as Media
}
package "Music Provider Workers" {
  component "Local Files / NAS Provider" as LocalProvider
  component "Online Music Providers" as OnlineProviders
}
component "Scraper Workers" as Scrapers
cloud "Music Platforms" as Cloud
cloud "Metadata Sources" as MetadataSources
folder "Allowed Local / Server-mounted NAS Roots" as NAS
UI --> API : HTTP / WebSocket
BP --> Stream : Audio
DUI --> API : HTTP / WebSocket
DP --> Stream : Audio
Native --> API : Health / Auth
API --> Library
API --> Metadata
API --> Media : Authorized content
API --> Playlist
API --> Resolver
Playlist --> Library
Playlist --> Scheduler : Sync jobs
Resolver --> Host
Stream --> Host : Read / Stream / Resolve / Refresh
Library --> DB
Library --> Scheduler : Scan jobs
Metadata --> Library : Version / Match
Metadata --> Scheduler : Automatic / Manual scrape
Metadata --> Host : Authorized local tag write
Metadata --> DB : References / Task state only
Metadata --> Media : Lyrics / Artwork / Metadata files
Playlist --> DB
Scheduler --> DB : Job state
Scheduler --> Host : Run plugin jobs
Host --> LocalProvider : Provider JSON-RPC
Host --> OnlineProviders : Provider JSON-RPC
Host --> Scrapers : Scraper JSON-RPC
OnlineProviders --> Cloud
LocalProvider --> NAS : Scan / Read / Stream / Opt-in tag write
Scrapers --> MetadataSources : Search / Fetch
note right of Host
  Shared runtime, separate provider / scraper roles.
  Independent registration, config and credentials.
end note
note bottom of Scrapers
  No online Music Provider is required.
  No permission to write original audio files.
  Local extraction uses read-only task resources from Host.
  Candidates are selected and published by Server.
end note
note bottom of Media
  Configurable directory separate from audio files.
  No file bodies in SQLite.
  Original audio writes are disabled by default.
end note
note bottom of UI
  Published UI package is bundled by desktop.
  Direct playback is optional when accessible.
end note
@enduml
