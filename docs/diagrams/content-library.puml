@startuml
title 本地音频作品库扩展（分阶段设计）
skinparam componentStyle rectangle
package "Server 主进程" {
  component "内容类型注册表\n通用作品服务" as works
  component "音乐内容插件" as music
  component "ASMR 内容插件" as asmr
  component "作品包预览／确认／重导入\n手动选择包边界" as importer
  component "CUE 解析器\n仅结构与时间范围" as cue
  component "本地文件 Provider\n授权目录／精确音频观察" as local
  component "版本化附件读取\n图片／文本预览与下载" as attachments
  component "作品级 Scraper\n待实施" as scraper
  component "稳定身份／授权／事务发布" as core
  component "SQLite 后端\n表结构与迁移" as db
  component "统一音频播放\n逻辑音轨区间支持待实施" as player
  music --> works : 类型声明
  asmr --> works : 类型声明
  local --> importer : 授权文件快照
  music --> importer : 保留目录／自然排序
  asmr --> importer : 保留目录／自然排序
  cue ..> importer : 后续接入分轨结构
  importer --> core : 完整快照／修订校验
  attachments --> local : 当前授权／固定版本
  scraper --> core : 作品资料候选
  works --> core : 作品读写
  core --> db
  core --> player : 来源与固定资产
}
component "Web 通用作品列表／详情\n按服务端声明展示角色与编号" as web
web --> works : 受鉴权 HTTP
web --> importer : 导入预览／包树
web --> attachments : 附件读取
web --> player : 受鉴权播放
note bottom of cue
不访问实体光盘，不抓轨，不切割原文件。
解析成功不代表分段播放已交付。
end note
@enduml
